{
  "name": "@bilazo/kito",
  "version": "0.0.1",
  "description": "A React design system built on Base UI and Tailwind CSS v4.",
  "keywords": [
    "base-ui",
    "react",
    "tailwindcss",
    "ui"
  ],
  "homepage": "https://github.com/bilazo/kito#readme",
  "bugs": {
    "url": "https://github.com/bilazo/kito/issues"
  },
  "license": "MIT",
  "author": "bilazo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilazo/kito.git"
  },
  "files": [
    "dist",
    "src/styles/defaults.css"
  ],
  "type": "module",
  "exports": {
    "./styles/defaults.css": "./src/styles/defaults.css",
    "./package.json": "./package.json",
    "./components/*": {
      "types": "./dist/components/*.d.mts",
      "import": "./dist/components/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0"
  },
  "devDependencies": {
    "@bilazo/oxc-config": "^1.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
